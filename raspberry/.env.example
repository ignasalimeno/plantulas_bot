# Backend (Render o local)
BACKEND_URL=https://plantulas-bot.onrender.com
# Token del dispositivo (se muestra una vez al crear el device en la app)
DEVICE_TOKEN=

# Home Assistant (corriendo en el Pi o red local)
HA_URL=http://localhost:8123
# Token de acceso de larga duración (HA -> perfil -> Long-Lived Access Tokens)
HA_TOKEN=

# Cada cuántos segundos lee y reporta
INTERVAL_SECONDS=60

# Las entidades de Home Assistant (temp, humedad, humidificador, aire,
# intractor, bomba, etc.) se configuran en la app:
#   indoor -> Dispositivos -> nuevo/editar dispositivo.

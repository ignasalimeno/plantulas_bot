# Backend (Render)
BACKEND_URL=https://plantulas-bot.onrender.com
# Token del dispositivo (se muestra una vez al crear el device en la app)
DEVICE_TOKEN=

# Home Assistant (corriendo en el Pi)
HA_URL=http://localhost:8123
# Token de acceso de larga duración (HA -> perfil -> Long-Lived Access Tokens)
HA_TOKEN=

# Entidades de Home Assistant
ENT_TEMP=sensor.carpa_temperatura
ENT_HUMIDITY=sensor.carpa_humedad
ENT_HUMIDIFIER=switch.humidificador
ENT_AC=climate.aire

# Cada cuántos segundos lee y aplica
INTERVAL_SECONDS=900
